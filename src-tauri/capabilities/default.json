{
  "identifier": "default",
  "description": "Default capabilities for Voxai",
  "windows": ["settings", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:tray:default",
    "shell:allow-open"
  ]
}
